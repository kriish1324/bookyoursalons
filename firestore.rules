rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bookings collection
    match /bookings/{bookingId} {
      // Allow read for authenticated users viewing their own bookings
      allow read: if request.auth != null;
      
      // Customers can create bookings
      allow create: if request.auth != null ||
                       request.resource.data.status == 'pending';
      
      // Allow updates for status changes
      allow update: if request.auth != null;
      
      // Allow delete for cancellations
      allow delete: if request.auth != null;
    }
    
    // Slots collection
    match /slots/{slotId} {
      // Anyone can read slots
      allow read: if true;
      
      // Only authenticated users can write slots (via transactions)
      allow write: if request.auth != null;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
